FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=replace-with-at-least-32-random-bytes
DATABASE_URL=sqlite:///instance/samm_assessment.db

INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=Change-Me-Now-2026!

CREATE_DEMO_DATA=false
DEMO_RESPONDENT_NAME=Respondedor Demo
DEMO_RESPONDENT_EMAIL=respondent@example.com
DEMO_RESPONDENT_PASSWORD=Change-Respondent-2026!
DEMO_REVIEWER_NAME=Revisor Demo
DEMO_REVIEWER_EMAIL=reviewer@example.com
DEMO_REVIEWER_PASSWORD=Change-Reviewer-2026!

UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=20
MAX_EVIDENCE_FILES_PER_QUESTION=10
MAX_REQUEST_CONTENT_LENGTH_MB=200
ALLOWED_EXTENSIONS=pdf,docx,xlsx,pptx,txt,csv,png,jpg,jpeg,zip

SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_MINUTES=480

LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12

ASSESSMENT_AUTOSAVE_SECONDS=30
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=200 per day;50 per hour
APP_NAME=NTT DevSecOps Assessment
LOG_LEVEL=INFO
FORCE_HTTPS=false
TRUST_PROXY_HEADERS=true
TRUSTED_HOSTS=localhost,127.0.0.1

# Fase 3: catálogo SAMM
CATALOG_IMPORT_FOLDER=instance/catalog_imports
MAX_CATALOG_IMPORT_MB=15
SAMM_IMPORT_FILE=data/SAMM_spreadsheet.xlsx
SAMM_DEFAULT_VERSION=2.2.0

# Fase 5: dashboards y resultados
CHART_JS_URL=https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js

# Fase 6: reportes, respaldos y producción
REPORT_FOLDER=reports
BACKUP_FOLDER=backups
REPORT_COMPANY_NAME=NTT DATA
REPORT_CLASSIFICATION=Confidencial
REPORT_LOGO_PATH=

# Gunicorn
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_LOG_LEVEL=info
